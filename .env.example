# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Healthcare AI Hybrid Graph RAG"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_key_in_production
API_KEYS={"admin":"replace-with-a-long-random-private-access-key"}
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]

# PostgreSQL Database (User-configured pgAdmin database: hybrid_rag)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hybrid_rag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/hybrid_rag

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_HTTPS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=healthcare_knowledge

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# LLM Providers (OpenAI primary, Groq and Gemini fallbacks)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-120b

GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Voice / Whisper
VOICE_TRANSCRIBE_PROVIDER=groq
